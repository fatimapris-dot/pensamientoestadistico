const sb=supabase.createClient(SU,SK);

const SES=[
{t:"Estadística descriptiva",d:"Tipos de variables, escala Likert, base de datos en SPSS, prueba de normalidad y contraste de hipótesis."},
{t:"Probabilidad",d:"Probabilidad y variable aleatoria, tablas de contingencia y alfa de Cronbach."},
{t:"Estadística inferencial",d:"Muestreo, intervalos de confianza, ANOVA y correlaciones de Pearson, Kendall y Spearman."},
{t:"Por definir"},{t:"Por definir"},{t:"Por definir"},{t:"Por definir"},{t:"Por definir"}];
