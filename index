 const s=SES[R.n-1];
 app.innerHTML=`${pasos(1)}<h1>Clase ${R.n}: ${esc(s.t)}</h1>
 <div class="card"><p>${esc(s.d)}</p></div>
 <div id="cn"><div class="pend"><b class="sans">Contenido y simulador de esta clase</b><p class="mut" style="margin:.4em 0 0">Aquí irán los conceptos, las actividades y el simulador interactivo (en construcción).</p></div></div>
 <div style="margin-top:14px"><button id="nx">Continuar a la canción</button></div>`;
 if(window.S1&&R.n===1)S1.render($("#cn"));
 $("#nx").onclick=()=>{R.c=Math.round((Date.now()-T)/1000);cancion()}}
function cancion(){
 app.innerHTML=`${pasos(2)}<div class="listen"><h2 style="margin:0">Escucha con atención</h2><p style="margin:.3em 0">La letra no se muestra. Después responderás un cuestionario.</p>
 <audio id="au" controls controlsList="nodownload" src="${songUrl(R.n)}"></audio></div>
 <p class="mut" id="est"></p><div style="margin-top:14px"><button id="nx">Continuar al cuestionario</button></div>`;
 const a=$("#au");
 a.addEventListener("loadedmetadata",()=>{R.tot=Math.round(a.duration)});
 a.addEventListener("play",()=>{if(a.currentTime<1.5)R.rep++;R.last=a.currentTime});
 a.addEventListener("seeking",()=>{R.last=a.currentTime});
 a.addEventListener("timeupdate",()=>{if(a.paused||a.seeking)return;const d=a.currentTime-R.last;if(d>0&&d<1.2)R.ef+=d;R.last=a.currentTime});
 a.addEventListener("ended",()=>{R.fin=true});
 a.addEventListener("error",()=>{$("#est").textContent="No se pudo cargar la canción. Avisa a la investigadora."});
 $("#nx").onclick=()=>{R.ef=Math.round(R.ef);T=Date.now();cuest()}}
function cuest(){
 const P=PREG[R.n]||[];
 app.innerHTML=`${pasos(3)}<h1>Cuestionario</h1>
 <div class="card">${P.map((x,i)=>`<div class="q"><b>${i+1}.</b> ${esc(x.q)}${x.o.map((o,j)=>`<label class="opt"><input type="radio" name="p${i+1}" value="${"abcde"[j]}"> ${"abcde"[j]}) ${esc(o)}</label>`).join("")}</div>`).join("")||`<p class="mut">Aún no hay preguntas de conocimiento para esta clase.</p>`}</div>
 ${R.n===1?`<div class="card"><div class="q"><b>¿Cuál es tu género de música favorito?</b>${GENEROS.map(g=>`<label class="opt"><input type="radio" name="gen" value="${esc(g)}"> ${esc(g)}</label>`).join("")}</div></div>`:""}
 <div class="card"><b class="sans">Satisfacción</b><p class="mut">1 = muy en desacuerdo · 5 = muy de acuerdo</p>${SAT.map((t,i)=>`<div class="q">${esc(t)}<div class="row">${[1,2,3,4,5].map(v=>`<label class="opt" style="display:inline-block;margin-right:12px"><input type="radio" name="sat${i+1}" value="${v}"> ${v}</label>`).join("")}</div></div>`).join("")}</div>
 <button id="en">Enviar y finalizar</button>`;
 $("#en").onclick=async()=>{const v=nm=>{const o=document.querySelector(`input[name=${nm}]:checked`);return o?o.value:null};
  const fila={grupo:GRUPO,consentimiento:true,sesion:R.n,seg_contenido:R.c,seg_cuestionario:Math.round((Date.now()-T)/1000),seg_cancion_total:R.tot,seg_escucha_efectiva:R.ef,reproducciones:R.rep,completo_cancion:R.fin};
  let falta=false;
  P.forEach((x,i)=>{const r=v("p"+(i+1));if(!r)falta=true;fila["p"+(i+1)]=r});
  SAT.forEach((t,i)=>{const r=v("sat"+(i+1));if(!r)falta=true;fila["sat"+(i+1)]=+r});
  if(R.n===1){const g=v("gen");if(!g)falta=true;fila.genero_musical=g}
  if(falta){alert("Responde todas las preguntas.");return}
  $("#en").disabled=true;
  const {error}=await sb.from("sesiones").insert(fila);
  if(error&&error.code!=="23505"){$("#en").disabled=false;alert("No se pudo guardar: "+error.message+". Intenta de nuevo.");return}
  S.done[R.n]=1;keep();
  app.innerHTML=`<h1>¡Listo!</h1><p>Tus respuestas quedaron registradas. Gracias por participar.</p><button id="hm">Volver al inicio</button>`;$("#hm").onclick=home}}

S.consent?home():consent();
</script>
