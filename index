// ===== CONSENTIMIENTO (se pide una vez por dispositivo; no se guarda ningún dato personal) =====
function consent(){
 app.innerHTML=`<p class="mut sans" style="margin:0">Maestría en Educación, mención Enseñanza de la Matemática · UTPL 2026</p>
