<script>
// ===== CONFIGURACIÓN =====
const SU="https://deisfckikietmupypzlz.supabase.co",SK="sb_publishable__XetEygAawGocYqSj4snOw_MXvTE_ue";
const GRUPO="musica";            // en la página del grupo de control: "control"
const CONTACTO="[tu correo]";
