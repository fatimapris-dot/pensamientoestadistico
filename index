`;
 document.querySelectorAll(".ses").forEach(b=>b.onclick=()=>sesion(+b.dataset.n));
}

// ===== SESIÓN: contenido → canción → cuestionario =====
let R,T;
function pasos(a){return `<div class="steps">${["1 Contenido","2 Canción","3 Cuestionario"].map((x,i)=>`<span class="${i+1===a?"on":""}">${x}</span>`).join("")}</div>`}
function sesion(n){R={n,c:0,q:0,tot:0,ef:0,rep:0,fin:false,last:0,p:{},sat:{},gen:null};T=Date.now();contenido()}
