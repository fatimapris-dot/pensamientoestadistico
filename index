<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pensamiento estadístico · Grupo música</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef1f6;--card:#fff;--ink:#14213d;--mut:#5a6783;--acc:#0f7b6c;--acc2:#e6f4f1;--on:#fff;--hl:#ffd166;--line:#cfd6e4}
@media (prefers-color-scheme:dark){:root{--bg:#101826;--card:#182235;--ink:#e8edf7;--mut:#9aa8c4;--acc:#4fd1b8;--acc2:#16322f;--on:#06201b;--line:#2b3a55}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 "Source Serif 4",Georgia,serif}
h1,h2,h3,button,.sans{font-family:"Bricolage Grotesque",system-ui,sans-serif}
main{max-width:860px;margin:0 auto;padding:20px 16px 60px}
h1{font-size:clamp(1.4rem,4vw,2rem);line-height:1.15;margin:.2em 0}
h2{font-size:1.2rem;margin:1.3em 0 .4em}
.mut{color:var(--mut)}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin:12px 0}
.grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
button,input,textarea{font:inherit;color:inherit}
button{background:var(--acc);color:var(--on);border:0;border-radius:8px;padding:9px 16px;cursor:pointer;font-weight:500}
button.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
button:disabled{opacity:.5;cursor:default}
:focus-visible{outline:3px solid var(--hl);outline-offset:2px}
input[type=text]{width:100%;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:9px;margin:4px 0}
.ses{text-align:left;width:100%;background:var(--card);color:var(--ink);border:1px solid var(--line);padding:14px}
.ses b{display:block}
.tag{display:inline-block;font:500 .8rem "Bricolage Grotesque",sans-serif;padding:2px 9px;border-radius:99px;background:var(--acc2);color:var(--acc)}
.q{border-top:1px solid var(--line);padding:12px 0}
