</head>
<body>
<main id="app"></main>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script>
/* Clase 1 · Estadística descriptiva. Archivo compartido: lo cargan la página de música y la de control. */
(function(){
const esc=t=>String(t??"").replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));
const fmt=(v,d=3)=>v.toFixed(d).replace(".",",");
const fp=p=>p<0.001?"< ,001":fmt(p,3);

// ===== Preguntas (opciones fijas; clave: b d a b c b d a b c) =====
const PREG=[
{q:"Un cuestionario mide la satisfacción con las categorías «muy baja, baja, media, alta, muy alta». ¿Qué nivel de medida tiene esta variable?",o:["Nominal","Ordinal","Intervalo","Razón"]},
{q:"La temperatura en grados Celsius es una variable de:",o:["Razón, porque el cero indica ausencia de temperatura","Nivel ordinal, porque se puede ordenar","Nivel nominal, porque son categorías","Intervalo, porque el cero es arbitrario"]},
{q:"En SPSS, la medida «Escala» agrupa a las variables de:",o:["Intervalo y de razón","Solo de razón","Solo de intervalo","Ordinal e intervalo"]},
{q:"Para describir la tendencia central de un ítem Likert individual, lo más apropiado es usar:",o:["Solo la media","La mediana y la moda","Solo el rango","Ninguna medida es válida"]},
{q:"¿Dónde se definen en SPSS el nombre, el tipo y el nivel de medida de cada variable?",o:["En la Vista de datos","En el menú Analizar","En la Vista de variables","En el Editor de resultados"]},
{q:"Con una muestra de 25 casos, ¿qué prueba de normalidad suele preferirse?",o:["Kolmogórov-Smirnov","Shapiro-Wilk","Chi-cuadrado","t de Student"]},
{q:"En una prueba de Shapiro-Wilk se obtiene Sig. = 0,32 con α = 0,05. La conclusión correcta es:",o:["Se demuestra que los datos son normales","Se rechaza H₀","Se acepta la hipótesis alternativa","No se rechaza H₀: no hay evidencia suficiente contra la normalidad"]},
{q:"Con muestras muy grandes, las pruebas de normalidad tienden a:",o:["Rechazar H₀ incluso ante desviaciones pequeñas, por lo que conviene apoyarse en gráficos","No rechazar nunca H₀","Dar siempre un valor p igual a 1","Perder validez porque exigen menos de 50 casos"]},
{q:"El valor p (Sig.) es:",o:["La probabilidad de que H₀ sea verdadera","La probabilidad de obtener un resultado igual o más extremo que el observado si H₀ fuera cierta","La probabilidad de cometer un error tipo I","La probabilidad de que H₁ sea verdadera"]},
{q:"La potencia de una prueba estadística es:",o:["La probabilidad de cometer un error tipo II","El valor 1 − α","La probabilidad de rechazar H₀ cuando H₀ es falsa (1 − β)","La probabilidad de rechazar H₀ cuando H₀ es verdadera"]}
];

// ===== Estadística =====
const mean=a=>a.reduce((s,v)=>s+v,0)/a.length;
const sd=a=>{const m=mean(a);return Math.sqrt(a.reduce((s,v)=>s+(v-m)**2,0)/(a.length-1))};
const med=a=>{const s=[...a].sort((x,y)=>x-y),h=s.length>>1;return s.length%2?s[h]:(s[h-1]+s[h])/2};
const poly=(c,x)=>{let r=0;for(let i=c.length-1;i>=0;i--)r=r*x+c[i];return r};
const erfc=x=>{const z=Math.abs(x),t=1/(1+.5*z),r=t*Math.exp(-z*z-1.26551223+t*(1.00002368+t*(.37409196+t*(.09678418+t*(-.18628806+t*(.27886807+t*(-1.13520398+t*(1.48851587+t*(-.82215223+t*.17087277)))))))));return x>=0?r:2-r};
const pup=z=>.5*erfc(z/Math.SQRT2);
function qn(p){const a=[-39.69683028665376,220.9460984245205,-275.9285104469687,138.357751867269,-30.66479806614716,2.506628277459239],b=[-54.47609879822406,161.5858368580409,-155.6989798598866,66.80131188771972,-13.28068155288572],c=[-.007784894002430293,-.3223964580411365,-2.400758277161838,-2.549732539343734,4.374664141464968,2.938163982698783],d=[.007784695709041462,.3224671290700398,2.445134137142996,3.754408661907416],pl=.02425;let q,r;
 if(p<pl){q=Math.sqrt(-2*Math.log(p));return(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)}
 if(p>1-pl){q=Math.sqrt(-2*Math.log(1-p));return-(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)}
 q=p-.5;r=q*q;return(((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q/(((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)}
// Shapiro-Wilk (Royston, 1995; válido para 3 ≤ n ≤ 5000)
function sw(x){x=[...x].sort((p,q)=>p-q);const n=x.length;if(n<3||n>5000)return null;const mu=mean(x),ss=x.reduce((s,v)=>s+(v-mu)**2,0);if(ss===0)return null;
 const h=n>>1,a=new Array(h+1).fill(0);
 if(n===3)a[1]=Math.SQRT1_2;else{const m=[0];for(let i=1;i<=h;i++)m[i]=qn((i-.375)/(n+.25));
  let s2=0;for(let i=1;i<=h;i++)s2+=m[i]*m[i];s2*=2;const r2=Math.sqrt(s2),rsn=1/Math.sqrt(n);
  a[1]=poly([0,.221157,-.147981,-2.07119,4.434685,-2.706056],rsn)-m[1]/r2;let i1,fac;
  if(n>5){i1=3;a[2]=-m[2]/r2+poly([0,.042981,-.293762,-1.752461,5.682633,-3.582633],rsn);fac=Math.sqrt((s2-2*m[1]**2-2*m[2]**2)/(1-2*a[1]**2-2*a[2]**2))}
  else{i1=2;fac=Math.sqrt((s2-2*m[1]**2)/(1-2*a[1]**2))}
  for(let i=i1;i<=h;i++)a[i]=-m[i]/fac}
 let b=0;for(let i=1;i<=h;i++)b+=a[i]*(x[n-i]-x[i-1]);const W=Math.min(1,b*b/ss);let p;
 if(W>=1)p=1;else if(n===3)p=Math.max(0,1.90985931710274*(Math.asin(Math.sqrt(W))-1.0471975511966));
 else{const y=Math.log(1-W);
  if(n<=11){const g=-2.273+.459*n;if(y>=g)p=1e-99;else p=pup((-Math.log(g-y)-poly([.544,-.39978,.025054,-6.714e-4],n))/Math.exp(poly([1.3822,-.77857,.062767,-.0020322],n)))}
  else{const xx=Math.log(n);p=pup((y-poly([-1.5861,-.31082,-.083751,.0038915],xx))/Math.exp(poly([-.4803,-.082676,.0030302],xx)))}}
 return{W,p,n}}

// ===== Datos =====
const V=(name,tipo,medida)=>({name,tipo,medida});
function ejemplo(){let s=7;const r=()=>(s=s*16807%2147483647)/2147483647,z=()=>Math.sqrt(-2*Math.log(r()))*Math.cos(2*Math.PI*r());
 const rows=[];for(let i=1;i<=40;i++){const it=[0,0,0].map(()=>Math.min(5,Math.max(1,Math.round(3.4+.9*z()))));rows.push([i,Math.round(30+6*z()),r()<.5?"H":"M",Math.round(700*Math.exp(.55*z())),...it,it[0]+it[1]+it[2]])}
 return{vars:[V("id","Numérico","nominal"),V("edad","Numérico","escala"),V("sexo","Cadena","nominal"),V("ingreso","Numérico","escala"),V("item1","Numérico","ordinal"),V("item2","Numérico","ordinal"),V("item3","Numérico","ordinal"),V("puntaje","Numérico","escala")],rows}}
function parse(t){const L=t.trim().split(/\r?\n/).filter(l=>l.trim());if(L.length<2)return null;const d=L[0].includes("\t")?"\t":L[0].includes(";")?";":",";
 const g=L.map(l=>l.split(d).map(c=>c.trim()));const k=g[0].length;if(g.some(r=>r.length!==k))return null;
 const cols=g[0].map((h,j)=>{const c=g.slice(1).map(r=>r[j]);const num=c.every(v=>v===""||!isNaN(+v.replace(",",".")));return{h:h||"var"+(j+1),c,num}});
 const vars=cols.map(o=>{if(!o.num)return V(o.h,"Cadena","nominal");const u=new Set(o.c.filter(v=>v!=="")),ent=[...u].every(v=>Number.isInteger(+v.replace(",",".")));return V(o.h,"Numérico",ent&&u.size<=7?"ordinal":"escala")});
 const rows=g.slice(1).map(r=>r.map((v,j)=>cols[j].num?(v===""?null:+v.replace(",",".")):v));return{vars,rows}}

// ===== Contenido =====
const CSS=`.s1 details{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin:8px 0}.s1 summary{cursor:pointer;font:600 1.05rem "Bricolage Grotesque",sans-serif}.s1 table{width:100%;border-collapse:collapse;font-size:.92rem;margin:8px 0}.s1 th,.s1 td{text-align:left;padding:6px;border-bottom:1px solid var(--line);vertical-align:top}.s1 .tb{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.s1 .tb button.on{outline:3px solid var(--hl)}.s1 .sc{overflow-x:auto;max-height:340px}.s1 select,.s1 textarea{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:6px;color:inherit;font:inherit}.s1 textarea{width:100%}.s1 .w{border-left:4px solid #e0a800;padding:6px 12px;margin:8px 0;background:var(--acc2)}.s1 .res{background:var(--acc2);border-radius:8px;padding:10px 14px;margin:8px 0}.s1 svg{max-width:100%;height:auto}.s1 .gr{display:flex;gap:14px;flex-wrap:wrap}`;
const CON=`
<details open><summary>1. Tipos de variables y niveles de medida</summary>
<p>Las variables <b>cualitativas</b> expresan categorías y las <b>cuantitativas</b> expresan cantidades (discretas si cuentan, continuas si miden). El <b>nivel de medida</b> decide qué operaciones y qué estadísticos tienen sentido.</p>
<table><tr><th>Nivel</th><th>Qué permite</th><th>Ejemplo</th></tr>
<tr><td>Nominal</td><td>Clasificar; no hay orden</td><td>Sexo, carrera</td></tr>
<tr><td>Ordinal</td><td>Ordenar; las distancias entre categorías no son iguales</td><td>Nivel de satisfacción</td></tr>
<tr><td>Intervalo</td><td>Distancias iguales; el cero es arbitrario</td><td>Temperatura en °C</td></tr>
<tr><td>Razón</td><td>Distancias iguales y cero absoluto (tiene sentido el cociente)</td><td>Edad, ingreso</td></tr></table>
<p>En SPSS, <b>Escala</b> agrupa intervalo y razón; las otras opciones son <b>Nominal</b> y <b>Ordinal</b>.</p></details>
<details><summary>2. Escala Likert</summary>
<p>Un <b>ítem Likert</b> (por ejemplo, de «totalmente en desacuerdo» a «totalmente de acuerdo») es una variable <b>ordinal</b>: hay orden, pero no se asegura que las distancias entre opciones sean iguales. Para un ítem se describen frecuencias, <b>mediana y moda</b>.</p>
<p>Una <b>escala Likert</b> (suma o promedio de varios ítems) suele tratarse como de intervalo en la práctica, siempre que los ítems midan un mismo constructo; es una decisión que debe justificarse y cuya confiabilidad se estudia con el alfa de Cronbach (semana 2).</p></details>
<details><summary>3. Base de datos en SPSS</summary>
<p>SPSS tiene dos vistas. La <b>Vista de variables</b> define la estructura: nombre, tipo, etiqueta, etiquetas de valores (por ejemplo, 1 = Mujer, 2 = Hombre), valores perdidos y <b>medida</b>. La <b>Vista de datos</b> contiene la matriz: <b>cada fila es un caso y cada columna una variable</b>. Definir bien la medida evita análisis inadecuados.</p></details>
<details><summary>4. Prueba de normalidad</summary>
<p>Muchas pruebas paramétricas suponen normalidad. Se contrasta H₀: «los datos provienen de una distribución normal» frente a H₁: «no provienen». Se complementa con el <b>histograma</b> y el <b>gráfico Q-Q</b>, donde los puntos deben seguir la diagonal.</p>
<p><b>Shapiro-Wilk</b> es la prueba más recomendada, en particular con muestras pequeñas o medianas. Si Sig. &gt; α, <b>no se rechaza</b> H₀: falta evidencia contra la normalidad, pero eso no la demuestra. Con muestras muy grandes, las pruebas detectan desviaciones mínimas y rechazan con facilidad, por lo que conviene apoyarse en los gráficos.</p></details>
<details><summary>5. Contraste de hipótesis</summary>
<p>Se plantean H₀ (hipótesis nula) y H₁ (alternativa) y se fija el nivel de significación <b>α</b>, la probabilidad máxima aceptada de <b>error tipo I</b> (rechazar una H₀ verdadera). El <b>error tipo II (β)</b> es no rechazar una H₀ falsa, y la <b>potencia (1 − β)</b> es la probabilidad de rechazar H₀ cuando es falsa.</p>
<p>El <b>valor p</b> (en SPSS, «Sig.») es la probabilidad de obtener un resultado tan extremo o más que el observado <b>si H₀ fuera cierta</b>. No es la probabilidad de que H₀ sea cierta. Si p ≤ α se rechaza H₀; si p &gt; α no se rechaza.</p></details>`;

function render(el){
 el.innerHTML=`<style>${CSS}</style><div class="s1"><h2>Conceptos clave</h2>${CON}
 <h2>Simulador tipo SPSS</h2><p class="mut">Versión educativa e independiente de SPSS. Carga datos, define su medida y contrasta la normalidad.</p>
 <div class="w"><b>Actividad guiada:</b> 1) carga los datos de ejemplo; 2) en Vista de variables revisa la medida de cada variable; 3) en Analizar, contrasta la normalidad de <i>edad</i> e <i>ingreso</i>; 4) intenta analizar <i>sexo</i> o <i>item1</i> y explica qué ocurre.</div>
 <div class="tb"><button id="ej">Cargar datos de ejemplo</button><button class="ghost" id="pg">Pegar mis datos (CSV)</button></div>
 <div id="pb" hidden><textarea id="tx" rows="5" placeholder="Primera fila con los nombres de las variables. Separador: coma, punto y coma o tabulador."></textarea><button id="ld" style="margin-top:6px">Cargar</button> <span id="er" class="mut"></span></div>
 <div id="sm" hidden><div class="tb"><button class="ghost" data-t="d">Vista de datos</button><button class="ghost" data-t="v">Vista de variables</button><button class="ghost" data-t="a">Analizar</button></div><div id="vw"></div></div></div>`;
 const q=s=>el.querySelector(s);let D=null,tab="d",sel=0,al=.05;
 const show=()=>{q("#sm").hidden=!D;el.querySelectorAll("[data-t]").forEach(b=>b.classList.toggle("on",b.dataset.t===tab));const f={d:vd,v:vv,a:va}[tab];f()};
 const set=d=>{D=d;tab="d";sel=Math.max(0,D.vars.findIndex(v=>v.tipo==="Numérico"));show()};
 q("#ej").onclick=()=>set(ejemplo());
 q("#pg").onclick=()=>{q("#pb").hidden=!q("#pb").hidden};
 q("#ld").onclick=()=>{const d=parse(q("#tx").value);if(!d){q("#er").textContent="No se pudo leer: revisa que todas las filas tengan el mismo número de columnas.";return}q("#er").textContent="";set(d)};
 el.querySelectorAll("[data-t]").forEach(b=>b.onclick=()=>{tab=b.dataset.t;show()});
 function vd(){q("#vw").innerHTML=`<p class="mut">${D.rows.length} casos · ${D.vars.length} variables (se muestran los primeros 20)</p><div class="sc"><table><tr>${D.vars.map(v=>`<th>${esc(v.name)}</th>`).join("")}</tr>${D.rows.slice(0,20).map(r=>`<tr>${r.map(c=>`<td>${c===null?".":esc(c)}</td>`).join("")}</tr>`).join("")}</table></div>`}
 function vv(){q("#vw").innerHTML=`<div class="sc"><table><tr><th>Nombre</th><th>Tipo</th><th>Medida</th><th>Observación</th></tr>${D.vars.map((v,i)=>`<tr><td>${esc(v.name)}</td><td>${v.tipo}</td><td><select data-i="${i}">${["nominal","ordinal","escala"].map(m=>`<option ${v.medida===m?"selected":""}>${m}</option>`).join("")}</select></td><td class="mut">${hint(v,i)}</td></tr>`).join("")}</table></div>`;
  q("#vw").querySelectorAll("select").forEach(s=>s.onchange=()=>{D.vars[+s.dataset.i].medida=s.value;vv()})}
 function hint(v,i){const c=col(i).filter(x=>x!==null);if(v.tipo==="Cadena"&&v.medida==="escala")return"Una variable de texto no puede ser de escala.";
  if(v.tipo==="Numérico"&&v.medida==="escala"&&new Set(c).size<=7&&c.every(Number.isInteger))return"Pocos valores enteros: ¿es realmente una variable de escala o un ítem ordinal?";
  if(v.tipo==="Numérico"&&v.medida==="nominal"&&new Set(c).size>10)return"Muchos valores distintos para una variable nominal.";return""}
 const col=i=>D.rows.map(r=>r[i]);
 function va(){const nums=D.vars.map((v,i)=>i).filter(i=>D.vars[i].tipo==="Numérico");
  q("#vw").innerHTML=`<div class="row" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center"><label>Variable <select id="sv">${D.vars.map((v,i)=>`<option value="${i}" ${i===sel?"selected":""}>${esc(v.name)}</option>`).join("")}</select></label><label>α <select id="sa">${[.05,.01,.1].map(a=>`<option value="${a}" ${a===al?"selected":""}>${fmt(a,2)}</option>`).join("")}</select></label></div><div id="out"></div>`;
  q("#sv").onchange=e=>{sel=+e.target.value;va()};q("#sa").onchange=e=>{al=+e.target.value;va()};
  const v=D.vars[sel],o=q("#out");
  if(v.tipo!=="Numérico"){o.innerHTML=`<div class="w">«${esc(v.name)}» es una variable de texto: no admite prueba de normalidad.</div>`;return}
  if(v.medida!=="escala"){o.innerHTML=`<div class="w">«${esc(v.name)}» está definida como <b>${v.medida}</b>. La prueba de normalidad se aplica a variables de <b>escala</b> (intervalo o razón). Para una variable ${v.medida} se describen frecuencias, moda${v.medida==="ordinal"?" y mediana":""}.</div>`;return}
  const x=col(sel).filter(c=>c!==null),r=sw(x);if(!r){o.innerHTML=`<div class="w">Se necesitan al menos 3 valores distintos.</div>`;return}
  const dec=r.p>al?`<b>No se rechaza H₀</b> (Sig. ${fp(r.p)} &gt; ${fmt(al,2)}): no hay evidencia suficiente contra la normalidad. Esto no demuestra que los datos sean normales.`:`<b>Se rechaza H₀</b> (Sig. ${fp(r.p)} ≤ ${fmt(al,2)}): hay evidencia de que la distribución se aparta de la normal.`;
  o.innerHTML=`<table style="max-width:520px"><tr><th>n</th><th>Media</th><th>Mediana</th><th>Desv. típica</th><th>Shapiro-Wilk</th><th>Sig.</th></tr><tr><td>${r.n}</td><td>${fmt(mean(x),2)}</td><td>${fmt(med(x),2)}</td><td>${fmt(sd(x),2)}</td><td>${fmt(r.W,3)}</td><td>${fp(r.p)}</td></tr></table>
  <div class="res">H₀: los datos provienen de una distribución normal. ${dec}${r.n>200?" Con muestras grandes apóyate también en los gráficos.":""}</div><div class="gr">${hist(x)}${qq(x)}</div>`}
 function hist(x){const k=Math.max(4,Math.ceil(Math.log2(x.length))+1),lo=Math.min(...x),hi=Math.max(...x),w=(hi-lo)/k||1,c=new Array(k).fill(0);x.forEach(v=>c[Math.min(k-1,Math.floor((v-lo)/w))]++);const m=Math.max(...c),bw=300/k;
  return`<svg viewBox="0 0 340 190" width="340" role="img" aria-label="Histograma"><text x="170" y="14" text-anchor="middle" font-size="12" fill="currentColor">Histograma</text>${c.map((n,i)=>`<rect x="${30+i*bw}" y="${160-n/m*130}" width="${bw-2}" height="${n/m*130}" fill="var(--acc)"/>`).join("")}<line x1="30" y1="160" x2="330" y2="160" stroke="currentColor"/><text x="30" y="178" font-size="11" fill="currentColor">${fmt(lo,1)}</text><text x="330" y="178" text-anchor="end" font-size="11" fill="currentColor">${fmt(hi,1)}</text></svg>`}
 function qq(x){const s=[...x].sort((a,b)=>a-b),n=s.length,m=mean(x),d=sd(x),z=s.map((_,i)=>qn((i+1-.5)/n)),lo=Math.min(s[0],m-2.5*d),hi=Math.max(s[n-1],m+2.5*d),X=v=>30+(v+3)/6*140,Y=v=>160-(v-lo)/(hi-lo)*130;
  return`<svg viewBox="0 0 200 190" width="220" role="img" aria-label="Gráfico Q-Q"><text x="100" y="14" text-anchor="middle" font-size="12" fill="currentColor">Gráfico Q-Q normal</text><line x1="${X(-3)}" y1="${Y(m-3*d)}" x2="${X(3)}" y2="${Y(m+3*d)}" stroke="currentColor" stroke-dasharray="4"/>${z.map((a,i)=>`<circle cx="${X(a)}" cy="${Y(s[i])}" r="2.6" fill="var(--acc)"/>`).join("")}<text x="100" y="182" text-anchor="middle" font-size="11" fill="currentColor">Cuantiles teóricos</text></svg>`}
}
window.S1={PREG,render,sw};
})();

